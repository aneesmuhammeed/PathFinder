# Copy to .env (never commit .env). Every line is optional: with no .env at all the app runs on the offline demo
# assistant against the embedded database from `python scripts/dev_stack.py`.

# --- Database (only needed when NOT using dev_stack.py / Docker Compose) ---
DATABASE_URL=postgresql+psycopg://pathfinder:pathfinder@localhost:5432/pathfinder
# Hosted Postgres URLs (postgres://… or postgresql://… from Neon, Supabase, Render) work as-is.

# --- LLM (leave all keys empty to use the built-in rule-based demo assistant) ---
# auto = the first key found below: Anthropic, then OpenAI, then Gemini.
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: override the model. Defaults: claude-opus-5-5 | gpt-4o-mini | gemini-2.5-flash.
# Cheaper Claude options: claude-sonnet-5-5, claude-haiku-5-5. Check each provider's current model names.
LLM_MODEL=
# Anthropic only: low | medium | high | xhigh | max (empty = the model's default)
LLM_EFFORT=
# OpenAI-compatible local servers (Ollama, vLLM):
OPENAI_BASE_URL=
LLM_TIMEOUT_S=90

# --- Cost and abuse protection (matters the moment a real LLM key is configured on a public server) ---
RATE_LIMIT_CHAT_PER_MIN=12      # chat turns per anonymous user per minute (0 = unlimited)
RATE_LIMIT_IP_PER_MIN=40        # chat turns per client IP per minute
RATE_LIMIT_SIGNUP_PER_HOUR=30   # new anonymous users per client IP per hour
DAILY_CHAT_CAP=2000             # total chat turns per UTC day, across everyone: a hard ceiling on your bill (0 = off)
TRUST_PROXY_HEADERS=false       # true only behind a reverse proxy you control (reads X-Forwarded-For)

# --- Agent ---
AGENT_MAX_STEPS=6
AGENT_HISTORY_TOKEN_BUDGET=30000

# --- Embeddings ---
# hash      = deterministic, offline, no downloads (lexical; for tests/demo)
# fastembed = real semantic model, local ONNX (pip install -r backend/requirements-ml.txt; ~130MB download once)
EMBEDDER=hash

# --- Ingestion ---
JOB_STALE_AFTER_DAYS=14
ARBEITNOW_PAGES=2
BOOTSTRAP_SEED=true             # load the demo jobs on start when the database is empty

# --- App ---
APP_ENV=dev                     # set to "prod" on a public deployment: logs configuration warnings at startup
LOG_LEVEL=INFO
LOG_JSON=false
DOCS_ENABLED=true               # set false to hide /docs on a public deployment
CORS_ORIGINS=http://localhost:5173   # your deployed web app's origin when the frontend is hosted separately
